# === ПерсДанные / Next.js BFF ===
# Скопируйте в .env.local и заполните.

# Базовый URL parser API (без trailing slash). Если НЕ задан — работает mock-парсер.
# Пример: http://127.0.0.1:8080
# Ngrok free: https://xxxx.ngrok-free.dev
# BFF всегда шлёт заголовок ngrok-skip-browser-warning на серверные fetch к парсеру.
PARSER_API_BASE=
# Алиас (то же самое): PARSER_API_URL=

# Предпочтительно: JWT через POST {BASE}/api/auth/login
PARSER_API_EMAIL=
PARSER_API_PASSWORD=

# Альтернатива (если в БД парсера ещё нет пользователей): Bearer-токен.
PARSER_API_TOKEN=
# Алиас: PARSER_API_KEY=

# Telegram-алерты менеджеру (серверные, токен в браузер не попадает).
# Если не заданы — сайт работает, алерт пишется в лог и пропускается.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Каждая завершённая проверка с лендинга (phase=done) уходит в Telegram,
# с рисками и без. PDF (sendDocument) — только если есть риски и pdf_ready.

# Публичный URL сайта (metadata). Опционально.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Режим форм.
# bff (по умолчанию) — браузер ходит только в /api/checks и /api/leads, BFF логинится в парсер.
# direct — браузер сам вызывает публичный API (NEXT_PUBLIC_PUBLIC_API_BASE). Vercel не видит ПДн.
# Переключение требует новой сборки: NEXT_PUBLIC_* вшиваются в клиентский бандл.
# NEXT_PUBLIC_FORMS_MODE=bff

# База публичного API парсера, без завершающего слэша. Нужна только в режиме direct.
# Пример: https://api.example.ru
# Локальный мок: npm run mock:public-api и http://127.0.0.1:8787
# NEXT_PUBLIC_PUBLIC_API_BASE=

# Ключ клиента Yandex SmartCaptcha (виджет). Серверный ключ на сайте не хранится:
# токен проверяет парсер. Скрипт грузится только в режиме direct.
# NEXT_PUBLIC_SMARTCAPTCHA_SITEKEY=

# Показывать fine_amount_text в карточке находки. Парсер пока отдаёт null.
# Любое значение кроме true скрывает суммы. Нужна новая сборка.
# NEXT_PUBLIC_SHOW_FINES=true
