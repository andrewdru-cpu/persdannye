# === ПерсДанные / Next.js BFF ===
# Скопируйте в .env.local и заполните.

# Базовый URL parser API (без trailing slash). Если НЕ задан — работает mock-парсер.
# Пример: http://127.0.0.1:8080
# Ngrok free: https://xxxx.ngrok-free.dev
# BFF всегда шлёт заголовок ngrok-skip-browser-warning на серверные fetch к парсеру.
PARSER_API_BASE=
# Алиас (то же самое): PARSER_API_URL=

# Предпочтительно: JWT через POST {BASE}/api/auth/login
PARSER_API_EMAIL=
PARSER_API_PASSWORD=

# Альтернатива (если в БД парсера ещё нет пользователей): Bearer-токен.
PARSER_API_TOKEN=
# Алиас: PARSER_API_KEY=

# Telegram-алерты менеджеру (серверные, токен в браузер не попадает).
# Если не заданы — сайт работает, алерт пишется в лог и пропускается.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Каждая завершённая проверка с лендинга (phase=done) уходит в Telegram,
# с рисками и без. PDF (sendDocument) — только если есть риски и pdf_ready.

# Публичный URL сайта (metadata). Опционально.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Точные Origin для POST /api/leads, через запятую: прод и каждый preview Vercel.
# Совпадение посимвольное, без масок. Нет заголовка, значение null и чужой хост — 403.
# В Production env Vercel переменная обязательна.
# ALLOWED_ORIGINS=https://persdannye.ru,https://persdannye.vercel.app,http://localhost:3000

# Ключ HMAC-SHA256 для X-PD-Sig на запросе лида в парсер (строка ts.ip).
# Если пусто, X-PD-Client-IP, X-PD-Ts и X-PD-Sig не отправляются.
# В Production env Vercel секрет обязателен.
# PD_BFF_SIGNING_SECRET=

# E2E, SUPPRESSION_MOCK, OUTBOUND_MOCK — только локально и на preview.
# Непустое значение при VERCEL_ENV=production или PD_DEPLOY_ENV=prod останавливает сборку.
# NODE_ENV не проверяется. В Production этих трёх переменных нет.

# Блок штрафов на лендинге. Сам по себе суммы не открывает.
# Нужны ОБА условия и пересборка:
#   1) NEXT_PUBLIC_SHOW_FINES=true
#   2) approved: true в content/fines.ts (ставит юрист)
# Флаг выключен — на странице нет ни цифр, ни фразы про масштаб штрафов.
# Флаг включён, approved: false — нейтральный текст без цифр, калькулятора нет.
# NEXT_PUBLIC_SHOW_FINES=true

# Атрибуция DB-IP Lite в футере. По умолчанию выключена, в том числе на превью.
# Включать после выката файла базы: NEXT_PUBLIC_SHOW_DBIP_ATTRIBUTION=true и пересборка.
# NEXT_PUBLIC_SHOW_DBIP_ATTRIBUTION=true

# Чекбокс согласия на рекламную рассылку в формах заявки и проверки.
# По умолчанию выключен, в том числе на превью: флаг show_marketing_consent в content/flags.ts.
# Включать только явно и пересобрать сайт: NEXT_PUBLIC_MARKETING_CONSENT=true
# NEXT_PUBLIC_MARKETING_CONSENT=false принудительно скрывает чекбокс.
# NEXT_PUBLIC_MARKETING_CONSENT=true
