# === ПерсДанные / Next.js BFF ===
# Скопируйте в .env.local и заполните. Значения сюда не пишите: файл в репозитории.

# Базовый URL parser API без завершающего слэша.
# Пустое значение: сервер сам берёт http://api:8080 (сервис api в compose).
PARSER_API_BASE=

# Bearer-токен парсера. Только в окружении контейнера, не в git.
PARSER_API_TOKEN=

# Публичный URL сайта (metadata). Опционально.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Блок штрафов на лендинге. Сам по себе суммы не открывает.
# Нужны ОБА условия и пересборка:
#   1) NEXT_PUBLIC_SHOW_FINES=true
#   2) approved: true в content/fines.ts (ставит юрист)
# Флаг выключен — на странице нет ни цифр, ни фразы про масштаб штрафов.
# Флаг включён, approved: false — нейтральный текст без цифр, калькулятора нет.
# NEXT_PUBLIC_SHOW_FINES=true

# Атрибуция DB-IP Lite в футере. По умолчанию выключена, в том числе на превью.
# Включать после выката файла базы: NEXT_PUBLIC_SHOW_DBIP_ATTRIBUTION=true и пересборка.
# NEXT_PUBLIC_SHOW_DBIP_ATTRIBUTION=true

# Сбор заявок, проверки URL, Яндекс.Метрики и необязательных cookie.
# Серверная переменная, без префикса NEXT_PUBLIC_: в браузер не попадает.
# Включено только при значении ровно true и опубликованной политике (show_site_legal).
# Включать одним шагом с публикацией политики: задать в Production и сделать redeploy.
# Пока переменная выключена, форма на сайте не показывается.
# Когда сбор включён, браузер шлёт заявку напрямую на https://api.scanweb.pro.
# Этот сервер тело заявки не принимает. Переменных мессенджера нет.
# PD_COLLECTION_ENABLED=true

# Чекбокс согласия на рекламную рассылку в формах заявки и проверки.
# По умолчанию выключен, в том числе на превью: флаг show_marketing_consent в content/flags.ts.
# Включать только явно и пересобрать сайт: NEXT_PUBLIC_MARKETING_CONSENT=true
# NEXT_PUBLIC_MARKETING_CONSENT=false принудительно скрывает чекбокс.
# NEXT_PUBLIC_MARKETING_CONSENT=true

# ФИО и ИНН плательщика налога на профессиональный доход.
# Пустые значения на сайт не выводятся. Реальные данные в репозиторий не пишите.
OPERATOR_FIO=
OPERATOR_INN=

# Почта для оферты, возврата и страницы контактов.
# Пустое или некорректное значение на сайт не выводится. Телефон сюда не добавлять.
SUPPORT_EMAIL=

# === Robokassa. Секреты только в окружении сервера, не в git. ===
# На сайте только логин и пароль №1. Пароль №2 (PASS2 и тестовый PASS2)
# на этот сайт не кладётся: его хранит только парсер и проверяет подпись ResultURL
# https://api.scanweb.pro/api/pay/robokassa/result
# Обработчик ResultURL в этом репозитории нет.
#
# В кабинете Robokassa:
# SuccessURL=https://scanweb.pro/pay/success
# FailURL=https://scanweb.pro/pay/fail
# Эти страницы не активируют тариф.
# ROBOKASSA_IS_TEST=1 — тестовый пароль №1 и параметр IsTest=1.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASS1=
ROBOKASSA_TEST_PASS1=
ROBOKASSA_IS_TEST=1

# Старт оплаты (подпись и ссылка на Robokassa). Пока не true, init отвечает 503.
# ROBOKASSA_PAY_ENABLED=true

# Алгоритм подписи, как в кабинете магазина. По умолчанию md5. Допустимо sha256.
# ROBOKASSA_HASH=md5

# Чекбокс автосписания на странице счёта. По умолчанию выключен.
# Только для счёта физического лица на подписку. Организациям и ИП не показывается.
# NEXT_PUBLIC_ROBOKASSA_RECURRING=true

# Черновик счёта, если у парсера ещё нет GET /api/pay/invoices/{invoiceId}.
# В проде не включать. Сумму в репозиторий не пишите: она задаётся только в окружении.
# PAY_INVOICE_STUB=true
# PAY_INVOICE_STUB_ID=
# PAY_INVOICE_STUB_INV_ID=
# PAY_INVOICE_STUB_TITLE=
# PAY_INVOICE_STUB_AMOUNT=
# PAY_INVOICE_STUB_STATUS=open
# PAY_INVOICE_STUB_PAYER=person
# PAY_INVOICE_STUB_PLAN=
# PAY_INVOICE_STUB_PERIOD=
# PAY_INVOICE_STUB_NEXT=
